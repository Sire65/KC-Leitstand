{
  "schemaVersion": "1.0.0",
  "version": "4.3.5",
  "projectId": "NL",
  "rules": {
    "singleMeasurementPerSensor": true,
    "onePrimaryRegisterPerSensor": true,
    "dashboardShowsSummaryOnly": true
  },
  "sensors": [
    {
      "id": "internet.router.reachable",
      "name": "Router erreichbar",
      "register": "internet",
      "category": "connectivity",
      "device": "gateway",
      "source": "router.ok",
      "enabledSetting": "router"
    },
    {
      "id": "internet.ping.cloudflare",
      "name": "Internet-Ping Cloudflare",
      "register": "internet",
      "category": "latency",
      "device": "internet",
      "source": "targets.cloudflare",
      "enabledSetting": "multiPing"
    },
    {
      "id": "internet.packetloss",
      "name": "Paketverlust",
      "register": "internet",
      "category": "quality",
      "device": "internet",
      "source": "quality.lossPct",
      "enabledSetting": "loss"
    },
    {
      "id": "internet.jitter.p95",
      "name": "Jitter P95",
      "register": "internet",
      "category": "quality",
      "device": "internet",
      "source": "quality.p95JitterMs",
      "enabledSetting": "jitter"
    },
    {
      "id": "internet.dns",
      "name": "DNS-Aufloesung",
      "register": "internet",
      "category": "dns",
      "device": "internet",
      "source": "dns",
      "enabledSetting": "dns"
    },
    {
      "id": "internet.ipv4",
      "name": "IPv4-Erreichbarkeit",
      "register": "internet",
      "category": "protocol",
      "device": "internet",
      "source": "ip.ipv4",
      "enabledSetting": "ipStack"
    },
    {
      "id": "internet.ipv6",
      "name": "IPv6-Erreichbarkeit",
      "register": "internet",
      "category": "protocol",
      "device": "internet",
      "source": "ip.ipv6",
      "enabledSetting": "ipStack"
    },
    {
      "id": "fritzbox.status",
      "name": "FRITZ!Box erreichbar",
      "register": "fritzbox",
      "category": "router",
      "device": "fritzbox",
      "source": "router",
      "enabledSetting": "router"
    },
    {
      "id": "fritzbox.docsis",
      "name": "DOCSIS-Zustand",
      "register": "fritzbox",
      "category": "docsis",
      "device": "fritzbox",
      "source": "routerImport",
      "enabledSetting": "docsis"
    },
    {
      "id": "wlan.status",
      "name": "WLAN-Status",
      "register": "wlan",
      "category": "wireless",
      "device": "fritzbox",
      "source": "fritzdiag",
      "enabledSetting": "wifi"
    },
    {
      "id": "wlan.mesh",
      "name": "Mesh-Status",
      "register": "wlan",
      "category": "mesh",
      "device": "fritzbox",
      "source": "fritzdiag.meshError",
      "enabledSetting": "wifi"
    },
    {
      "id": "pc.cpu.total",
      "name": "CPU-Gesamtauslastung",
      "register": "pc",
      "category": "performance",
      "device": "desktop-pc",
      "source": "system.cpuPct",
      "enabledSetting": "system"
    },
    {
      "id": "pc.memory.total",
      "name": "RAM-Auslastung",
      "register": "pc",
      "category": "performance",
      "device": "desktop-pc",
      "source": "system.memPct",
      "enabledSetting": "system"
    },
    {
      "id": "pc.disk.activity",
      "name": "Datentraegeraktivitaet",
      "register": "pc",
      "category": "storage",
      "device": "desktop-pc",
      "source": "system.diskPct",
      "enabledSetting": "system"
    },
    {
      "id": "pc.ui.lag",
      "name": "UI-Lag",
      "register": "pc",
      "category": "performance",
      "device": "desktop-pc",
      "source": "lagState.current",
      "enabledSetting": "lag"
    },
    {
      "id": "pc.smart",
      "name": "SMART-Gesundheit",
      "register": "pc",
      "category": "storage",
      "device": "desktop-pc",
      "source": "smart",
      "enabledSetting": "smart"
    }
  ]
}
