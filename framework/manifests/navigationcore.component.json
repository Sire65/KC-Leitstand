{
  "componentId": "NavigationCore",
  "componentType": "core",
  "version": "1.1.0",
  "apiVersion": "1.1.0",
  "owner": "Framework",
  "entrypoints": [
    "framework/core/navigationcore.js",
    "app/assets/js/navigationcore-master.js",
    "app/assets/css/navigationcore-master.css"
  ],
  "dependencies": {
    "InteractionCore": ">=1.1.0",
    "DesignCore": ">=1.1.0",
    "CapabilityCore": ">=1.1.0",
    "MobileCore": ">=1.1.0"
  },
  "capabilities": [
    "collapsible-sidebar",
    "quick-icons",
    "grouped-navigation",
    "pin-state",
    "user-panel",
    "office-mode-entry",
    "keyboard-access",
    "touch-access"
  ],
  "supportedDevices": [
    "desktop",
    "tablet",
    "mobile"
  ],
  "configurationSchema": "app/config/navigation.json",
  "migration": {
    "strategy": "adapter",
    "preserveProjectConfig": true,
    "rollbackRequired": true,
    "preflight": [
      "component-contract",
      "dependency-compatibility",
      "project-config-valid",
      "baseline-regression"
    ],
    "postflight": [
      "navigation-render",
      "navigation-actions",
      "office-entry",
      "device-layout",
      "rollback-package"
    ]
  },
  "qa": {
    "staticChecks": [
      "manifest-schema",
      "entrypoints-exist",
      "unique-navigation-ids",
      "no-inline-project-overwrite"
    ],
    "regressionGates": [
      "dashboard-reachable",
      "all-existing-pages-reachable",
      "sidebar-collapse",
      "group-toggle",
      "office-mode-start"
    ]
  }
}
